# ── Telegram ──────────────────────────────────────────────────────
# Bot token from @BotFather
MESHB_TELEGRAM_TOKEN=your-token-here
# Group ID (negative integer) — get from @userinfobot
MESHB_TELEGRAM_ROOM=-1001234567890
# Admin user ID (positive integer) — get from @userinfobot
MESHB_TELEGRAM_ADMIN=12345678
# Bot must have privacy mode disabled to see group messages
MESHB_TELEGRAM_BOT_IN_ROOMS=true
MESHB_TELEGRAM_NOTIFICATIONS_ENABLED=false

# ── Meshtastic Node ──────────────────────────────────────────────
# TCP connection to node — node must have WiFi enabled on port 4403
MESHB_MESHTASTIC_DEVICE=tcp:192.168.1.100
MESHB_MESHTASTIC_ADMIN=!deadbeef
MESHB_MESHTASTIC_DATABASE_FILE=/app/data/meshtastic.sqlite
MESHB_MESHTASTIC_FIFO_PATH=/tmp/mtg.fifo
MESHB_MESHTASTIC_FIFO_CMD_PATH=/tmp/mtg.cmd.fifo
MESHB_MESHTASTIC_NODE_LOG_ENABLED=false
MESHB_MESHTASTIC_NODE_LOG_FILE=/tmp/node_log.csv
MESHB_MESHTASTIC_FIFO_ENABLED=false
MESHB_MESHTASTIC_WELCOME_MESSAGE=Welcome to our community
MESHB_MESHTASTIC_WELCOME_MESSAGE_ENABLED=false
MESHB_MESHTASTIC_MAX_HOP_COUNT=5

# ── Runtime ──────────────────────────────────────────────────────
TZ=UTC
MESHB_DEBUG=false

# ── WebApp ───────────────────────────────────────────────────────
MESHB_WEBAPP_ENABLED=true
MESHB_WEBAPP_PORT=5000
MESHB_WEBAPP_CENTER_LATITUDE=46.2382
MESHB_WEBAPP_CENTER_LONGITUDE=-63.1311
MESHB_WEBAPP_LAST_HEARD_DEFAULT=3600
MESHB_WEBAPP_AIR_RAID_ENABLED=false
MESHB_WEBAPP_AIR_RAID_PRIVATE=changeme
MESHB_WEBAPP_EXTERNAL_URL=http://localhost:5000
MESHB_WEBAPP_SHORTENER_SERVICE=
MESHB_WEBAPP_TLY_TOKEN=
MESHB_WEBAPP_PLSST=
MESHB_WEBAPP_REDRAW_MARKERS_EVERY=60
MESHB_WEBAPP_API_KEY=

# ── MQTT ─────────────────────────────────────────────────────────
MESHB_MQTT_ENABLED=false
MESHB_MQTT_TOPIC=msh
MESHB_MQTT_CHANNEL=LongFast
MESHB_MQTT_HOST=mqtt.eclipseprojects.io
MESHB_MQTT_PORT=1883
MESHB_MQTT_USER=
MESHB_MQTT_PASSWORD=

# ── APRS ─────────────────────────────────────────────────────────
MESHB_APRS_ENABLED=false

# ── Sentry ───────────────────────────────────────────────────────
MESHB_SENTRY_ENABLED=false
MESHB_SENTRY_DSN=
